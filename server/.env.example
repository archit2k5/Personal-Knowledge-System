# Server & Environment
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5174

# Database
MONGODB_URI=mongodb://localhost:27017/pks
REDIS_URL=redis://localhost:6379

# Auth & Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_change_me_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me_in_production
ACCESS_TTL=15m
REFRESH_TTL=7d

# Email / Mailtrap
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
EMAIL_FROM="Personal Knowledge System <no-reply@personalknowledge.local>"
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=1h
EMAIL_RESEND_COOLDOWN_SEC=60

# LLM / Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_QUERY_REWRITE_MODEL=llama-3.1-8b-instant

# Embeddings & Vector Database
EMBEDDING_PROVIDER=@huggingface/transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kb-uploads
R2_ENDPOINT=
R2_PRESIGN_TTL=300

# Limits & RAG Tuning
MAX_UPLOAD_MB=20
RAG_TOP_K=6
RAG_MIN_SCORE=0.5
HISTORY_WINDOW=10
CHUNK_TOKENS=600
CHUNK_OVERLAP=80
